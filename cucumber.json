{
  "default": {
    "formatOptions": {
      "snippetInterface": "async-await"
    },
    "paths": [
      "src/test/features/**/*.feature"
    ],
    "require": [
      "src/test/steps/**/*.ts"
    ],
    "requireModule": [
      "ts-node/register"
    ],
    "publishQuiet": true,
    "dryRun": false
  },
  "orangehrm": {
    "formatOptions": {
      "snippetInterface": "async-await"
    },
    "paths": [
      "src/test/features/OrangeHRMFeatures/**/*.feature"
    ],
    "require": [
      "src/test/steps/OrangeHrmsteps/**/*.ts"
    ],
    "requireModule": [
      "ts-node/register"
    ],
    "publishQuiet": true,
    "dryRun": true
  },
  "demoapp": {
    "formatOptions": {
      "snippetInterface": "async-await"
    },
    "paths": [
      "src/test/features/demoapplicationFeatureFiles/**/*.feature"
    ],
    "require": [
      "src/test/steps/demoapplicationSteps/**/*.ts"
    ],
    "requireModule": [
      "ts-node/register"
    ],
    "publishQuiet": true,
    "dryRun": true
  }
}