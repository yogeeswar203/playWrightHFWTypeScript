{
  "default": {
    "formatOptions": {
      "snippetInterface": "async-await",
      "resultsDir": "allure-results"
    },
    
    "require": [
      "src/test/steps/**/*.ts",
      "src/hooks/hooks.ts"
    ],
    "requireModule": [
      "ts-node/register"
    ],
    "format":[
      "progress",
      "allure-cucumberjs/reporter"

    ],
    "publishQuiet": true,
    "dryRun": false
  },
  "orangehrm": {
    "formatOptions": {
      "snippetInterface": "async-await",
      "resultsDir": "allure-results"
    },
    "paths": [
      "src/test/features/OrangeHRMFeatures/**/*.feature"
    ],
    "require": [
      "src/test/steps/OrangeHrmsteps/**/*.ts",
      "src/hooks/hooks.ts"
    ],
    "requireModule": [
      "ts-node/register"
    ],
     "format":[
  
      "progress",
      "allure-cucumberjs/reporter"

    ],
    "publishQuiet": true,
    "dryRun": true
  },
  "demoapp": {
    "formatOptions": {
      "snippetInterface": "async-await",
      "resultsDir": "allure-results"
    },
    "paths": [
      "src/test/features/demoapp/**/*.feature"
    ],
    "require": [
      "src/test/steps/demoapp/**/*.ts"
    ],
    "requireModule": [
      "ts-node/register"
    ],
    "format":[
    
      "progress",
      "allure-cucumberjs/reporter"

    ],
    "publishQuiet": true,
    "dryRun": false
  }

}