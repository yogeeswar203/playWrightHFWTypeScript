{
  "name": "playwrighthybridframework",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "cucumber-js test/features/**/*.feature",
    "report": "npx ts-node src/helper/report.js",
    "pretest": "rimraf allure-results allure-report",
    "allure:generate": "npx allure generate ./allure-results --clean -o allure-report",
